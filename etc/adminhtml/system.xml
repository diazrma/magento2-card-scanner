<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="magepanda_cardscanner" translate="label" sortOrder="410" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Card Scanner</label>
            <tab>sales</tab>
            <resource>MagePanda_CardScanner::config</resource>
            <group id="general" translate="label comment" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <comment><![CDATA[Adds a "Scan card" button to payment methods that render card fields on the checkout page. OCR runs in the shopper's browser: the image is never uploaded or stored. Card fields inside a payment provider iframe (hosted fields) cannot be filled by any extension.]]></comment>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Active</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="show_on_desktop" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show on Desktop</label>
                    <comment>On desktop the shopper can use the webcam or upload a photo. Set to "No" to show the button only on touch devices.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="allowed_methods" translate="label comment" type="multiselect" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Only in These Payment Methods</label>
                    <comment>None selected = every payment method where card fields are found.</comment>
                    <source_model>Magento\Payment\Model\Config\Source\Allmethods</source_model>
                    <can_be_empty>1</can_be_empty>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="native_autocomplete" translate="label comment" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Native Browser Autocomplete</label>
                    <comment>Adds autocomplete="cc-number", "cc-exp"... to the card fields. This also enables the native autofill and card scanning of Safari (iOS) and Chrome (Android).</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="button_label" translate="label comment" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Button Text</label>
                    <comment>Empty = "Scan card".</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>
        </section>
    </system>
</config>
