{
    "name": "kingofpanda/module-card-scanner",
    "description": "Magento 2: escaneie o cartão pela câmera no checkout e preencha os campos de qualquer método de pagamento. OCR 100% no navegador (Tesseract.js).",
    "type": "magento2-module",
    "license": "MIT",
    "keywords": [
        "magento2",
        "magento",
        "adobe-commerce",
        "checkout",
        "credit-card",
        "ocr",
        "card-scanner",
        "tesseract"
    ],
    "authors": [
        {
            "name": "Rodrigo Cardoso",
            "homepage": "https://github.com/diazrma"
        }
    ],
    "require": {
        "magento/framework": "103.0.*",
        "magento/module-checkout": "100.4.*",
        "magento/module-payment": "100.4.*",
        "magento/module-store": "101.1.*"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "MagePanda\\CardScanner\\": ""
        }
    }
}
